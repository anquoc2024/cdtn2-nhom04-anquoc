# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit file .env / .env.local.
# Giá trị công khai (được đưa vào trình duyệt): Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# BÍ MẬT – chỉ dùng cho `npm run seed:users` trên máy cá nhân. Không thêm tiền tố VITE_, không đưa lên Vercel.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
SEED_ADMIN_EMAIL=admin@thuynail.vn
SEED_ADMIN_PASSWORD=<mật khẩu ≥ 8 ký tự>
SEED_ADMIN_NAME=Chủ tiệm
SEED_ADMIN_PHONE=0900000001
SEED_USER_EMAIL=khach@thuynail.vn
SEED_USER_PASSWORD=<mật khẩu ≥ 8 ký tự>
SEED_USER_NAME=Khách mẫu
SEED_USER_PHONE=0900000002
